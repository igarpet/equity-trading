# Copy to .env and fill in. .env is git-ignored; never commit it.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_PAPER=true
# Shared market-data folder (holds Deribit/, Binance/); Alpaca/ is created inside it
EQUITY_TRADING_DIR=D:/MarketData
# Databento historical key (Futures_Order_Flow); the $125 sign-up credit expires after 6 months
DATABENTO_API_KEY=
# SEC EDGAR fair-access User-Agent (Fair_Value): your name and contact e-mail
SEC_USER_AGENT=
